# Copy to .env.demo. Never publish .env.demo or paste keys into a screenshot.
# This template has no credentials and performs no model calls by itself.
RAG_DEMO_DOMAIN=demo.example.com
RAG_PORT=18001
# local = offline retrieval. Set api only when models, key and prices below are configured.
RAG_MODE=local
RAG_API_KEY=
RAG_BASE_URL=https://api.openai.com/v1
RAG_CHAT_MODEL=gpt-5.6-luna
RAG_VERIFIER_MODEL=gpt-5.6-luna
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Use your provider's current per-million-token prices; missing/zero prices block paid calls.
RAG_EMBEDDING_USD_PER_MILLION_TOKENS=
RAG_CHAT_INPUT_USD_PER_MILLION_TOKENS=
RAG_CHAT_OUTPUT_USD_PER_MILLION_TOKENS=
RAG_VERIFIER_INPUT_USD_PER_MILLION_TOKENS=
RAG_VERIFIER_OUTPUT_USD_PER_MILLION_TOKENS=
RAG_DEMO_DAILY_USD=1
RAG_DEMO_USER_DAILY=20
RAG_DEMO_GLOBAL_DAILY=100
RAG_DEMO_IP_MINUTE=10
RAG_DEMO_CONCURRENT=2
RAG_DEMO_OUTPUT_TOKENS=4096
RAG_DEMO_INPUT_BYTES=60000
