# Optional: keys entered in the UI are kept in server memory until restart.
RAG_API_KEY=
RAG_BASE_URL=https://api.openai.com/v1
RAG_CHAT_MODEL=gpt-4o-mini
# Leave verifier empty to reuse the generator; set another model for independence.
RAG_VERIFIER_MODEL=
RAG_VERIFICATION_MODE=strict
# Required only for independent semantic evaluation; never implicitly reused.
RAG_EVAL_JUDGE_MODEL=
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Set RAG_MODE=api to enable API embeddings and generated answers at startup.
RAG_MODE=local
# RAG_DATA_DIR=./data

# Chunk units are characters (not model tokens). Overlap must be smaller than size.
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_SEARCH_MODE=exact

# Leave empty for the offline SQLite baseline. Set to use native PostgreSQL vectors.
RAG_DATABASE_URL=
# Dedicated test / benchmark databases. Scripts use unique isolated schemas.
RAG_TEST_DATABASE_URL=
RAG_BENCHMARK_DATABASE_URL=

# Docker Compose: choose your own database password, then put its URL-encoded
# value in RAG_DATABASE_URL_DOCKER. The db host is the Compose service name.
POSTGRES_PASSWORD=
RAG_DATABASE_URL_DOCKER=
# Example format: postgresql://knowbase:URL_ENCODED_PASSWORD@db:5432/knowbase
RAG_PORT=8000

# USD per million tokens, using your provider's actual model prices.
# Blank = unknown cost, never zero. Update these when changing models/providers.
RAG_EMBEDDING_USD_PER_MILLION_TOKENS=
RAG_CHAT_INPUT_USD_PER_MILLION_TOKENS=
RAG_CHAT_OUTPUT_USD_PER_MILLION_TOKENS=
RAG_VERIFIER_INPUT_USD_PER_MILLION_TOKENS=
RAG_VERIFIER_OUTPUT_USD_PER_MILLION_TOKENS=
RAG_JUDGE_INPUT_USD_PER_MILLION_TOKENS=
RAG_JUDGE_OUTPUT_USD_PER_MILLION_TOKENS=
